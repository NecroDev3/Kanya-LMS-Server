# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_PATH=./data/student_ms.db

# CORS (comma-separated origins)
FRONTEND_URL=http://localhost:5173

# Rate limiting (requests per IP per window; window = 15 minutes)
# Production defaults if unset: API 100, auth 20.
# Development defaults if unset: API 2000, auth 120 (still capped, but comfortable for HMR/Strict Mode).
API_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=

# Behind nginx, Railway, etc.: set so X-Forwarded-For is honored and limits apply per real client.
# TRUST_PROXY=1

# Email — Resend (https://resend.com). Leave blank to log emails to stdout instead.
RESEND_API_KEY=
# Sender address shown to recipients (must be a verified domain in Resend)
EMAIL_FROM=LMS <noreply@yourdomain.com>
# Human-readable name shown in email templates
LMS_NAME=SM Web Systems LMS
